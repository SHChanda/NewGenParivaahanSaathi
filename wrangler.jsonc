{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sarathi-next-demo",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-27",
  "assets": { "directory": "public", "binding": "ASSETS" },
  "d1_databases": [{ "binding": "DB", "database_name": "sarathi-next-demo", "database_id": "replace-after-d1-create" }],
  "r2_buckets": [{ "binding": "DOCUMENTS", "bucket_name": "sarathi-next-documents" }]
}
